{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RenanTalk",
  "version": "0.1.0",
  "identifier": "com.renanrmsantos14.renantalk",
  "build": {
    "frontendDist": "../app/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RenanTalk",
        "width": 800,
        "height": 580,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
