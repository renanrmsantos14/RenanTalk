{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RenanTalk",
  "version": "0.0.4",
  "identifier": "br.com.renan.renantalk",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:36495",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; style-src-attr 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBMDQ3NUQ1RjM2MEQ4QTUKUldTbDJHRHoxWFVFS3V2NVFlek8zK3pha1ArWk9LM2c3QnVOWUJkUmVxWFZLVzIzVTRmNHpIUlUK",
      "endpoints": [
        "https://github.com/renanrmsantos14/RenanTalk/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
